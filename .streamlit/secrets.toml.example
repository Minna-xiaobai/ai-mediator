# Copy these into Streamlit Community Cloud → your app → Settings → Secrets.
# Never commit a real secrets.toml (it is in .gitignore).

GROQ_API_KEY = "gsk_..."
# Supabase → Project → Connect → "Transaction pooler" URI (port 6543), with your DB password filled in.
DATABASE_URL = "postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres"
# Optional: require this code to sign up during the beta (remove to open sign-ups).
BETA_ACCESS_CODE = "choose-a-code"
# Shown in the Privacy Policy and Terms as the contact address.
CONTACT_EMAIL = "you@example.com"
